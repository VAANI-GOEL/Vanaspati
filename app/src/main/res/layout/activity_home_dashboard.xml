<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1F0F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ═══════════════════════════════════════════════
             HEADER SECTION
        ════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="52dp"
            android:paddingBottom="20dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:background="#0F1F0F">

            <!-- App label row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="VANASPATI"
                    android:textColor="#3A6A3A"
                    android:textSize="10sp"
                    android:letterSpacing="0.2"
                    android:fontFamily="sans-serif-medium" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/green_dot" />

            </LinearLayout>

            <!-- Dynamic greeting -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good morning 🌅"
                android:textColor="#E8F5E8"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:layout_marginBottom="4dp" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keep your garden happy 🌿"
                android:textColor="#4A7A4A"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════
             CARE TIP CARD
        ════════════════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#1A2E1A"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="#3A7A3A" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DAILY TIP"
                        android:textColor="#3A6A3A"
                        android:textSize="9sp"
                        android:letterSpacing="0.15"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvCareTip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💧  Most plants prefer to dry out slightly between watering."
                        android:textColor="#7AB87A"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.5" />

                </LinearLayout>
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ═══════════════════════════════════════════════
             QUICK PLANT CHIPS
        ════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUICK START"
            android:textColor="#3A6A3A"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-medium"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="10dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_marginBottom="24dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip0"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:text="🌵 Cactus"
                    android:textColor="#8AC88A"
                    android:textSize="13sp"
                    app:chipBackgroundColor="#1A3A1A"
                    app:chipStrokeColor="#2D5A2D"
                    app:chipStrokeWidth="1dp"
                    app:chipCornerRadius="18dp"
                    style="@style/Widget.MaterialComponents.Chip.Action" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip1"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:text="🌿 Pothos"
                    android:textColor="#8AC88A"
                    android:textSize="13sp"
                    app:chipBackgroundColor="#1A3A1A"
                    app:chipStrokeColor="#2D5A2D"
                    app:chipStrokeWidth="1dp"
                    app:chipCornerRadius="18dp"
                    style="@style/Widget.MaterialComponents.Chip.Action" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip2"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:text="🌹 Rose"
                    android:textColor="#8AC88A"
                    android:textSize="13sp"
                    app:chipBackgroundColor="#1A3A1A"
                    app:chipStrokeColor="#2D5A2D"
                    app:chipStrokeWidth="1dp"
                    app:chipCornerRadius="18dp"
                    style="@style/Widget.MaterialComponents.Chip.Action" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip3"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:text="🌻 Sunflower"
                    android:textColor="#8AC88A"
                    android:textSize="13sp"
                    app:chipBackgroundColor="#1A3A1A"
                    app:chipStrokeColor="#2D5A2D"
                    app:chipStrokeWidth="1dp"
                    app:chipCornerRadius="18dp"
                    style="@style/Widget.MaterialComponents.Chip.Action" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip4"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🍃 Fern"
                    android:textColor="#8AC88A"
                    android:textSize="13sp"
                    app:chipBackgroundColor="#1A3A1A"
                    app:chipStrokeColor="#2D5A2D"
                    app:chipStrokeWidth="1dp"
                    app:chipCornerRadius="18dp"
                    style="@style/Widget.MaterialComponents.Chip.Action" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- ═══════════════════════════════════════════════
             FEATURE CARDS ROW
        ════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXPLORE"
            android:textColor="#3A6A3A"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-medium"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_marginBottom="28dp">

            <!-- Card: Water Guide -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                app:cardBackgroundColor="#1A2E1A"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:gravity="bottom">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💧"
                        android:textSize="22sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Water\nGuide"
                        android:textColor="#7AB87A"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingMultiplier="1.2" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card: Sunlight -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                app:cardBackgroundColor="#1E2A12"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:gravity="bottom">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="☀️"
                        android:textSize="22sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sunlight\nTracker"
                        android:textColor="#A8C870"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingMultiplier="1.2" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card: Season Tips -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#1A2A20"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:gravity="bottom">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌱"
                        android:textSize="22sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Season\nTips"
                        android:textColor="#6AB8A0"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingMultiplier="1.2" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════
             PRIMARY BUTTON — Add Plant
        ════════════════════════════════════════════════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddPlant"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="12dp"
            android:text="＋  Add a New Plant"
            android:textColor="#C8F0C8"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            app:backgroundTint="#2D5C2D"
            app:cornerRadius="28dp"
            app:strokeColor="#3A7A3A"
            app:strokeWidth="1dp"
            app:elevation="0dp" />

        <!-- ═══════════════════════════════════════════════
             SECONDARY BUTTON — Identify with AI
        ════════════════════════════════════════════════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIdentifyNow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="12dp"
            android:text="🔍  Identify Plant with AI"
            android:textColor="#6AB86A"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            app:backgroundTint="#1A2E1A"
            app:cornerRadius="28dp"
            app:strokeColor="#2D5A2D"
            app:strokeWidth="1dp"
            app:elevation="0dp" />

        <!-- ═══════════════════════════════════════════════
             FOOTER NOTE
        ════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="Powered by AI · Vanaspati v1.0"
            android:textColor="#2A4A2A"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>