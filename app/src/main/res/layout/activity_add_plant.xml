<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1F0F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- ═══ HEADER ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="52dp"
            android:paddingBottom="24dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADD PLANT"
                    android:textColor="#3A6A3A"
                    android:textSize="10sp"
                    android:letterSpacing="0.2"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tell us about your plant 🌿"
                    android:textColor="#E8F5E8"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Details saved to your garden"
                    android:textColor="#4A7A4A"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ═══ FORM SECTION LABEL ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PLANT DETAILS"
            android:textColor="#3A6A3A"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-medium"
            android:layout_marginLeft="24dp"
            android:layout_marginBottom="12dp" />

        <!-- Plant Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPlantName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="14dp"
            android:hint="Plant name  (e.g. Money Plant)"
            app:boxBackgroundColor="#1A2E1A"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:hintTextColor="#4A7A4A"
            app:boxStrokeColor="#2D5A2D"
            app:errorTextColor="#E57373"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPlantName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E8F5E8"
                android:textColorHint="#4A7A4A"
                android:textSize="14sp"
                android:inputType="textCapSentences"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Plant Type dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPlantType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="14dp"
            android:hint="Plant type"
            app:boxBackgroundColor="#1A2E1A"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:hintTextColor="#4A7A4A"
            app:boxStrokeColor="#2D5A2D"
            app:errorTextColor="#E57373"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

            <AutoCompleteTextView
                android:id="@+id/actvPlantType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E8F5E8"
                android:textColorHint="#4A7A4A"
                android:textSize="14sp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Location -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="14dp"
            android:hint="Location  (e.g. Balcony, Living room)"
            app:boxBackgroundColor="#1A2E1A"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:hintTextColor="#4A7A4A"
            app:boxStrokeColor="#2D5A2D"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E8F5E8"
                android:textColorHint="#4A7A4A"
                android:textSize="14sp"
                android:inputType="textCapSentences"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Watering Frequency -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilWatering"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="14dp"
            android:hint="Watering frequency  (e.g. Every 3 days)"
            app:boxBackgroundColor="#1A2E1A"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:hintTextColor="#4A7A4A"
            app:boxStrokeColor="#2D5A2D"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWatering"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E8F5E8"
                android:textColorHint="#4A7A4A"
                android:textSize="14sp"
                android:inputType="textCapSentences"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Notes -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="32dp"
            android:hint="Notes  (optional)"
            app:boxBackgroundColor="#1A2E1A"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:hintTextColor="#4A7A4A"
            app:boxStrokeColor="#2D5A2D"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E8F5E8"
                android:textColorHint="#4A7A4A"
                android:textSize="14sp"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ═══ SAVE BUTTON ═══ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePlant"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="12dp"
            android:text="Save Plant to My Garden"
            android:textColor="#C8F0C8"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="#2D5C2D"
            app:cornerRadius="28dp"
            app:strokeColor="#3A7A3A"
            app:strokeWidth="1dp"
            app:elevation="0dp" />

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:indeterminateTint="#6AB86A" />

    </LinearLayout>
</ScrollView>