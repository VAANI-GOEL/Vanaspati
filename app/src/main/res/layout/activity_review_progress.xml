<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1A0A"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rose Growth"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:fontFamily="sans-serif-light"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/healthCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="#1A2E1A"
            app:cardCornerRadius="32dp"
            app:strokeColor="#4CAF50"
            app:strokeWidth="1.5dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:id="@+id/tvPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="85%"
                    android:textColor="#FFFFFF"
                    android:textSize="56sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VITALITY STATUS: HEALTHY"
                    android:textColor="#81C784"
                    android:textSize="12sp"
                    android:letterSpacing="0.1" />

                <ProgressBar
                    android:id="@+id/pbWater"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="32dp"
                    android:progress="85"
                    android:progressDrawable="@drawable/progress_green_theme" />

                <ProgressBar
                    android:id="@+id/pbManure"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="20dp"
                    android:progress="60"
                    android:progressDrawable="@drawable/progress_green_theme" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/healthCard">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnLogSun"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="12dp"
                app:cardBackgroundColor="#0D3B0D"
                app:cardCornerRadius="40dp"
                app:strokeColor="#FFD54F"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="☀️"
                    android:textSize="28sp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnLogWater"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="12dp"
                app:cardBackgroundColor="#0D3B0D"
                app:cardCornerRadius="40dp"
                app:strokeColor="#81C784"
                app:strokeWidth="1dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="💧" android:textSize="28sp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnLogManure"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="12dp"
                app:cardBackgroundColor="#0D3B0D"
                app:cardCornerRadius="40dp"
                app:strokeColor="#81C784"
                app:strokeWidth="1dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="🌱" android:textSize="28sp" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>